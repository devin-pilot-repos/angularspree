{
  "compilerOptions": {
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "lib": ["es2020", "dom"],
    "outDir": "../out-tsc/app",
    "target": "es2020",
    "module": "es2020",
    "baseUrl": "",
    "types": ["node"],
    "skipLibCheck": true,
    "paths": {
      "@core": ["./app/core/*"]
    }
  },
  "exclude": ["test.ts", "**/*.spec.ts", "../node_modules/protractor/**/*"]
}
